# =====================================================================
# Neek Watches — Application Environment Configuration
# =====================================================================

# Server Environment
NODE_ENV=development
PORT=3000

# MongoDB Database Connection
# For Local Docker Compose: mongodb://mongo:27017/neek_watches
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/neek_watches?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/neek_watches

# Security & Authentication
JWT_SECRET=neek_watches_luxury_secret_jwt_key_2026
SESSION_SECRET=neek_super_secret_session_key_2026

# External API Configuration
CORS_ORIGIN=*
VITE_API_URL=/api
